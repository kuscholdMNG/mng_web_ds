{
  "$description": "MNG Web Design System shadows (elevation). Generated from the Figma shadow/* effect styles (Shadows page); never edit by hand. Black only; offsets and blur reference spacing tokens. Mastheads use shadow/masthead, a WordPress Elements style that is not exported yet.",
  "shadow": {
    "$type": "shadow",
    "sm": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.25,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": "{spacing.050}",
        "blur": "{spacing.050}",
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "inset": false
      },
      "$description": "Sticky bars.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "effectStyle": "shadow/sm"
          },
          "rgba": "rgba(0, 0, 0, 0.25)",
          "hex8": "#00000040"
        }
      }
    },
    "md": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.2,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": "{spacing.050}",
        "blur": "{spacing.100}",
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "inset": false
      },
      "$description": "Cards.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "effectStyle": "shadow/md"
          },
          "rgba": "rgba(0, 0, 0, 0.2)",
          "hex8": "#00000033"
        }
      }
    },
    "lg": {
      "$value": {
        "color": {
          "colorSpace": "srgb",
          "components": [
            0,
            0,
            0
          ],
          "alpha": 0.2,
          "hex": "#000000"
        },
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": "{spacing.100}",
        "blur": "{spacing.200}",
        "spread": {
          "value": 0,
          "unit": "px"
        },
        "inset": false
      },
      "$description": "Anything floating: modals, bottom panels, dropdowns, menus, tooltips.",
      "$extensions": {
        "com.mng": {
          "figma": {
            "file": "MNG Web Design System",
            "effectStyle": "shadow/lg"
          },
          "rgba": "rgba(0, 0, 0, 0.2)",
          "hex8": "#00000033"
        }
      }
    }
  }
}
